# Varshi Enterprises Environment Variables

# Backend Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Database (PostgreSQL recommended in production; falls back to SQLite if PostgreSQL is unavailable)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/varshi_db
# Or for local SQLite:
# DATABASE_URL=sqlite:///./varshi.db

# JWT Security
JWT_SECRET=super_secret_varshi_enterprises_jwt_key_change_in_production_2025
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Cloudinary / Image Storage (Optional for Phase 1, ready for Phase 2 image hosting)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Groq AI Intelligence
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b



# Executive Persona & Timezone
ADMIN_PREFERRED_TITLE=Chief
STORE_TIMEZONE=Asia/Kolkata

